# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude: writing, editing, proofreading, publishing copy
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ChatGPT image model: cover artwork (and the five basic narration voices)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Each image token counts this many times against the monthly allowance
IMAGE_TOKEN_WEIGHT=3

# ElevenLabs: premium audiobook narration (elevenlabs.io → Developers → API keys).
# Use a paid ElevenLabs plan with Pay As You Go: library voices aren't available through the API on the free plan.
ELEVENLABS_API_KEY=
# Optional: the model behind each quality, and what ElevenLabs charges per 1,000 characters (used for the margin report)
ELEVENLABS_TURBO_MODEL=eleven_v4_turbo
ELEVENLABS_STANDARD_MODEL=eleven_v4
ELEVENLABS_TURBO_PRICE=0.04
ELEVENLABS_STANDARD_PRICE=0.08

# Stripe: card payments (dashboard.stripe.com → Developers). Use sk_test_ keys until you're ready for real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (developer.paypal.com). Plans are created for you at Admin → Billing setup.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Only if you made PayPal plans by hand before Billing setup existed (USD Pro and Agency)
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
NEXT_PUBLIC_PAYPAL_PLAN_AGENCY=

# Pounds are counted at this many dollars in the narration margin report (kept low on purpose)
GBP_USD_RATE=1.30

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
CRON_SECRET=

# Optional: notification emails via Resend
RESEND_API_KEY=
EMAIL_FROM=AI Publisher <hello@your-domain.com>
