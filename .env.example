# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude: writing, editing, proofreading, publishing copy
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ChatGPT image model: cover artwork
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Each image token counts this many times against the monthly allowance
IMAGE_TOKEN_WEIGHT=3

# PayPal subscriptions (developer.paypal.com)
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
NEXT_PUBLIC_PAYPAL_PLAN_AGENCY=
PAYPAL_WEBHOOK_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
CRON_SECRET=

# Optional: notification emails via Resend
RESEND_API_KEY=
EMAIL_FROM=AI Publisher <hello@your-domain.com>
